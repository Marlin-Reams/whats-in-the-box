rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.uid in ["4KIcgyhSYMP9jUxeXb6zlQpgHon1", "TKv1BxfBQaRnGFpgh9KOF6Z3wAf2"]; }
    function own(data) { return signedIn() && data.userId == request.auth.uid; }
    function member(fid) { return signedIn() && get(/databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid)).data.role in ['owner','member']; }
    function owner(fid) { return signedIn() && get(/databases/$(database)/documents/families/$(fid)).data.ownerUid == request.auth.uid; }
    function boxFields(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.notes is string && data.notes.size() <= 2000
        && (!('location' in data) || (data.location is string && data.location.size() <= 200));
    }
    function itemFields(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.quantity is int && data.quantity > 0 && data.quantity <= 100000
        && data.description is string && data.description.size() <= 2000
        && (data.boxId == null || data.boxId is string)
        && (!('photo' in data) || data.photo == null || (data.photo is string && data.photo.size() <= 2048));
    }
    function personalDestination(data) {
      return data.boxId == null ||
        (getAfter(/databases/$(database)/documents/boxes/$(data.boxId)).data.userId == request.auth.uid
          && getAfter(/databases/$(database)/documents/boxes/$(data.boxId)).data.get('deleting', false) == false);
    }
    function familyDestination(fid, data) {
      return data.boxId == null || (existsAfter(/databases/$(database)/documents/families/$(fid)/boxes/$(data.boxId))
        && getAfter(/databases/$(database)/documents/families/$(fid)/boxes/$(data.boxId)).data.get('deleting', false) == false);
    }
    function personalPhoto(data) {
      return !('photoPath' in data) || data.photoPath == null ||
        (data.photoPath is string && data.photoPath.matches('user_uploads/' + request.auth.uid + '/[^/]+'));
    }
    function familyPhoto(fid, data) {
      return (!('photo' in data) || data.photo == null) &&
        (!('photoPath' in data) || data.photoPath == null ||
          (data.photoPath is string && data.photoPath.matches('family_uploads/' + fid + '/[^/]+')));
    }
    match /boxes/{id} {
      allow create: if own(request.resource.data) && boxFields(request.resource.data)
        && request.resource.data.keys().hasOnly(['title','notes','location','userId','createdAt']);
      allow read, delete: if own(resource.data);
      allow update: if own(resource.data) && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','notes','location','deleting']) && boxFields(request.resource.data)
        && (!('deleting' in request.resource.data) || request.resource.data.deleting is bool);
    }
    match /items/{id} {
      allow create: if own(request.resource.data) && itemFields(request.resource.data) && personalDestination(request.resource.data)
        && personalPhoto(request.resource.data) && request.resource.data.keys().hasOnly(['name','quantity','description','boxId','photo','photoPath','userId','createdAt']);
      allow read, delete: if own(resource.data);
      allow update: if own(resource.data) && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','quantity','description','boxId','photo','photoPath'])
        && itemFields(request.resource.data) && personalPhoto(request.resource.data) && personalDestination(request.resource.data);
    }
    match /families/{fid} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.keys().hasOnly(['name','ownerUid','createdAt']);
      allow read: if member(fid);
      allow update, delete: if false;
      match /members/{uid} {
        function joining() {
          let invite = get(/databases/$(database)/documents/familyInvites/$(request.resource.data.inviteCode));
          return invite.data.familyId == fid && invite.data.expiresAt > request.time;
        }
        allow get: if signedIn() && (request.auth.uid == uid || member(fid));
        allow list: if member(fid);
        allow create: if signedIn() && uid == request.auth.uid
          && request.resource.data.name is string && request.resource.data.name.size() <= 120
          && request.resource.data.keys().hasOnly(['role','name','joinedAt','inviteCode'])
          && ((request.resource.data.role == 'owner' && getAfter(/databases/$(database)/documents/families/$(fid)).data.ownerUid == uid)
            || (request.resource.data.role == 'member' && joining()));
        allow update: if owner(fid) && uid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['member','revoked'];
        allow delete: if signedIn() && uid == request.auth.uid && resource.data.role == 'member';
      }
      match /boxes/{id} {
        allow read, delete: if member(fid);
        allow create: if member(fid) && own(request.resource.data) && boxFields(request.resource.data)
          && request.resource.data.keys().hasOnly(['title','notes','location','userId','createdAt','legacyId']);
        allow update: if member(fid) && request.resource.data.userId == resource.data.userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','notes','location','deleting']) && boxFields(request.resource.data)
          && (!('deleting' in request.resource.data) || request.resource.data.deleting is bool);
      }
      match /items/{id} {
        allow read, delete: if member(fid);
        allow create: if member(fid) && own(request.resource.data) && itemFields(request.resource.data)
          && familyPhoto(fid, request.resource.data) && familyDestination(fid, request.resource.data)
          && request.resource.data.keys().hasOnly(['name','quantity','description','boxId','photo','photoPath','userId','createdAt']);
        allow update: if member(fid) && request.resource.data.userId == resource.data.userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','quantity','description','boxId','photo','photoPath'])
          && itemFields(request.resource.data) && familyPhoto(fid, request.resource.data) && familyDestination(fid, request.resource.data);
      }
    }
    match /users/{uid}/families/{fid} {
      allow read: if signedIn() && uid == request.auth.uid;
      allow create, update: if signedIn() && (uid == request.auth.uid || owner(fid))
        && getAfter(/databases/$(database)/documents/families/$(fid)/members/$(uid)).data.role in ['owner','member']
        && request.resource.data.keys().hasOnly(['name']) && request.resource.data.name is string && request.resource.data.name.size() <= 80;
      allow delete: if signedIn() && (uid == request.auth.uid || owner(fid));
    }
    match /familyInvites/{code} {
      allow get: if signedIn();
      allow list: if owner(resource.data.familyId);
      allow create: if signedIn() && owner(request.resource.data.familyId) && request.resource.data.createdBy == request.auth.uid
        && code.matches('[a-f0-9]{32}') && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time && request.resource.data.expiresAt <= request.time + duration.value(8, 'd')
        && request.resource.data.keys().hasOnly(['familyId','createdBy','expiresAt']);
      allow delete: if owner(resource.data.familyId);
      allow update: if false;
    }
    function requestFields(data) {
      return own(data) && data.description is string && data.description.size() > 0 && data.description.size() <= 4000
        && data.status == 'submitted' && data.type in ['bug','feature','support']
        && data.keys().hasOnly(['userId','description','submittedAt','status','type']);
    }
    match /requests/{id} {
      allow create: if requestFields(request.resource.data);
      allow read, delete: if admin();
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['submitted','working','testing','corrected'];
    }
    match /bugReports/{id} {
      allow create: if false;
      allow read, update, delete: if admin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
